# Copy to .env.local for development. On Vercel, set the same keys under
# Project Settings → Environment Variables.

# Postgres. Locally this is your own server; on Vercel use Neon, Supabase or Vercel
# Postgres and paste the pooled connection string.
DATABASE_URL=postgres://postgres:password@localhost:5432/learnmaker

# The one admin account. Compared as plain text — keep this file out of git and rotate
# the password if it is ever exposed.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Signs the session cookie. Any long random string; `openssl rand -hex 32` is fine.
# Changing it signs everyone out.
SESSION_SECRET=

# Images are stored in Postgres and served from /media/…, so there is no object store
# to configure and no storage credentials to set.

# --- AI ------------------------------------------------------------------------
# Nothing to set. The Ask panel and diagram generation use the reader's or author's own
# Google credentials, entered in the browser and kept in that browser's localStorage.
# This server never holds a key, never sees a question, and stores no answers.
